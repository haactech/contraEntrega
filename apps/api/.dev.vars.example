# con el secreto real que entrega pey.
PEY_WEBHOOK_SECRET=whsec_JXEt49kFe6kj4ldka6fZwHTeXS9aIed4SYZ4EhpiNKk=
# >= 32 caracteres aleatorios (openssl rand -base64 32)
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_SELLER_PIN=1234
